<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="C:\Projects\KohakuEngine\project\KohakuEngine.vcxproj" />
  <PropertyGroup>
    <ProjectName>ElectricGatePreview</ProjectName>
    <TargetName>ElectricGatePreview</TargetName>
    <IntDir>$(projectRootPath)..\generated\obj\ElectricGatePreview\$(Platform)\$(Configuration)\</IntDir>
    <OutDir>$(projectRootPath)..\generated\outputs\$(Configuration)\</OutDir>
    <TargetFileName>ElectricGatePreview.exe</TargetFileName>
    <TargetPath>$(OutDir)ElectricGatePreview.exe</TargetPath>
    <GameObjectConfiguration>$(Configuration)</GameObjectConfiguration>
    <GameObjectConfiguration Condition="'$(Configuration)' == 'Development'">Develop</GameObjectConfiguration>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>$(IntDir)GameplayCollisionGameObjects.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <GameBuildSource Include="@(ClCompile)" />
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="C:\Projects\KohakuEngine\output\electric_gate_v1\ElectricGatePreview.cpp" />
    <GameObject Include="@(GameBuildSource->'$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(GameObjectConfiguration)\%(Filename).obj')" Exclude="$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(GameObjectConfiguration)\main.obj" />
  </ItemGroup>
  <!-- 必要な翻訳単位だけをリンクし、無関係なシーンをテストへ持ち込まない。 -->
  <Target Name="ArchiveGameObjects" BeforeTargets="Link">
    <WriteLinesToFile File="$(IntDir)GameplayCollisionGameObjects.rsp" Lines="@(GameObject->'&quot;%(FullPath)&quot;')" Overwrite="true" />
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx64\x64\lib.exe&quot; /nologo /OUT:&quot;$(IntDir)GameplayCollisionGameObjects.lib&quot; @&quot;$(IntDir)GameplayCollisionGameObjects.rsp&quot;" />
  </Target>
</Project>

