<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="..\..\KohakuEngine.vcxproj" />
  <PropertyGroup>
    <ProjectName>TutorialStepTests</ProjectName>
    <TargetName>TutorialStepTests</TargetName>
    <IntDir>$(projectRootPath)..\generated\obj\TutorialStepTests\$(Platform)\$(Configuration)\</IntDir>
    <OutDir>$(projectRootPath)..\generated\outputs\$(Configuration)\</OutDir>
    <TargetFileName>TutorialStepTests.exe</TargetFileName>
    <TargetPath>$(OutDir)TutorialStepTests.exe</TargetPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link><SubSystem>Console</SubSystem></Link>
    <ClCompile><UndefinePreprocessorDefinitions>NDEBUG;%(UndefinePreprocessorDefinitions)</UndefinePreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <!-- チュートリアル統合後のテストは、先にビルドしたゲームのオブジェクトを再利用する。 -->
  <ItemGroup>
    <GameBuildSource Include="@(ClCompile)" />
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(projectRootPath)Tests\TutorialStepTests.cpp" />
    <Object Include="@(GameBuildSource->'$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(Configuration)\%(Filename).obj')" Exclude="$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(Configuration)\main.obj" />
  </ItemGroup>
</Project>
