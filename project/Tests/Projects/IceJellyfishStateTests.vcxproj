<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="..\..\KohakuEngine.vcxproj" />
  <PropertyGroup>
    <ProjectName>IceJellyfishStateTests</ProjectName>
    <TargetName>IceJellyfishStateTests</TargetName>
    <IntDir>$(projectRootPath)..\generated\obj\IceJellyfishStateTests\$(Platform)\$(Configuration)\</IntDir>
    <OutDir>$(projectRootPath)..\generated\outputs\$(Configuration)\</OutDir>
    <TargetFileName>IceJellyfishStateTests.exe</TargetFileName>
    <TargetPath>$(OutDir)IceJellyfishStateTests.exe</TargetPath>
    <GameObjectConfiguration>$(Configuration)</GameObjectConfiguration>
    <GameObjectConfiguration Condition="'$(Configuration)' == 'Development'">Develop</GameObjectConfiguration>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>$(IntDir)IceJellyfishGameObjects.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <GameBuildSource Include="@(ClCompile)" />
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(projectRootPath)Tests\IceJellyfishStateTests.cpp" />
    <GameObject Include="@(GameBuildSource->'$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(GameObjectConfiguration)\%(Filename).obj')" Exclude="$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(GameObjectConfiguration)\main.obj" />
  </ItemGroup>
  <!-- 必要な翻訳単位だけをリンクし、無関係なシーンをテストへ持ち込まない。 -->
  <Target Name="ArchiveGameObjects" BeforeTargets="Link">
    <WriteLinesToFile File="$(IntDir)IceJellyfishGameObjects.rsp" Lines="@(GameObject->'&quot;%(FullPath)&quot;')" Overwrite="true" />
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx64\x64\lib.exe&quot; /nologo /OUT:&quot;$(IntDir)IceJellyfishGameObjects.lib&quot; @&quot;$(IntDir)IceJellyfishGameObjects.rsp&quot;" />
  </Target>
</Project>
