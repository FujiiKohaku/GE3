<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
  </PropertyGroup>
  <Import Project="..\..\KohakuEngine.vcxproj" />
  <PropertyGroup>
    <ProjectName>EncapsulationTests</ProjectName>
    <TargetName>EncapsulationTests</TargetName>
    <IntDir>$(projectRootPath)..\generated\obj\EncapsulationTests\$(Platform)\$(Configuration)\</IntDir>
    <OutDir>$(projectRootPath)..\generated\outputs\$(Configuration)\</OutDir>
    <TargetFileName>EncapsulationTests.exe</TargetFileName>
    <TargetPath>$(OutDir)EncapsulationTests.exe</TargetPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link><SubSystem>Console</SubSystem><AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;winspool.lib;comdlg32.lib;advapi32.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;odbc32.lib;odbccp32.lib</AdditionalDependencies></Link>
    <ClCompile><UndefinePreprocessorDefinitions>NDEBUG;%(UndefinePreprocessorDefinitions)</UndefinePreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <GameBuildSource Include="@(ClCompile)" />
    <ProjectReference Remove="@(ProjectReference)" />
    <ClCompile Remove="@(ClCompile)" />
    <ClCompile Include="$(projectRootPath)Tests\EncapsulationTests.cpp" />
  </ItemGroup>
  <!-- Optional runtime checks reuse a completed application build. -->
  <ItemDefinitionGroup Condition="'$(VerifyGameObjects)' == 'true'">
    <ClCompile><PreprocessorDefinitions>VERIFY_GAME_OBJECTS;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
    <Link><AdditionalDependencies>assimp-vc143-mtd.lib;imgui.lib;DirectXTex.lib;$(DlssNgxLibrary);%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(VerifyGameObjects)' == 'true'">
    <Object Include="@(GameBuildSource->'$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(Configuration)\%(Filename).obj')" Exclude="$(projectRootPath)..\generated\obj\KohakuEngine\$(Platform)\$(Configuration)\main.obj" />
  </ItemGroup>
</Project>
